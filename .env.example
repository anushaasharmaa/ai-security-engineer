# Copy to .env and adjust. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://secuser:secpass@localhost:5432/security_db
# Separate database used by pytest so tests never touch demo data
TEST_DATABASE_URL=postgresql+psycopg2://secuser:secpass@localhost:5432/security_test_db

# Where the dashboard and pipeline script find the API
API_URL=http://localhost:8000

# Embeddings: "hash" (default, offline, no downloads) or "sentence-transformers"
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM for the advisory explanation (optional).
# Leave LLM_API_KEY / LLM_MODEL empty to use the extractive fallback (no LLM).
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, Groq, OpenRouter, Ollama...).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
